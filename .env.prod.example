# ============================================
# DataPilot Production Configuration
# Copy to .env.prod and fill in real values
# ============================================
#
# Generate secrets:
#   SECRET_KEY / JWT_SECRET_KEY:  openssl rand -hex 64
#   POSTGRES_PASSWORD / REDIS_PASSWORD:  openssl rand -hex 32
#   DB_ENCRYPTION_KEY:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Application ---
APP_NAME=DataPilot
APP_ENV=production
DEBUG=false
SECRET_KEY=<run: openssl rand -hex 64>

# --- URLs ---
BACKEND_URL=https://ufuq.fyi
FRONTEND_URL=https://ufuq.fyi
CORS_ORIGINS=["https://ufuq.fyi"]
NEXT_PUBLIC_API_URL=https://ufuq.fyi/api/v1

# --- PostgreSQL ---
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=<run: openssl rand -hex 32>

# --- Redis ---
REDIS_PASSWORD=<run: openssl rand -hex 32>

# --- JWT ---
JWT_SECRET_KEY=<run: openssl rand -hex 64>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption ---
DB_ENCRYPTION_KEY=<run: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">

# --- OAuth (Google) ---
OAUTH_GOOGLE_CLIENT_ID=<your-google-client-id>
OAUTH_GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# --- OAuth (Microsoft) ---
OAUTH_MICROSOFT_CLIENT_ID=<your-microsoft-client-id>
OAUTH_MICROSOFT_CLIENT_SECRET=<your-microsoft-client-secret>

# --- OpenAI ---
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4
AI_PROVIDER=openai

# --- Upload ---
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=/app/uploads

# --- Domain (used by deploy.sh) ---
DOMAIN=ufuq.fyi
CERT_EMAIL=<your-email-for-letsencrypt>
